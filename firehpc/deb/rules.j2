#!/usr/bin/make -f

# Fake NVIDIA tools are a standalone Python project in a subdirectory of
# FireHPC sources. PYBUILD_NAME gives it its own pybuild home directory
# (.pybuild/cpython3_X.Y_nvidia-fake) where its wheel is built and unpacked,
# separated from FireHPC wheel. It is installed directly in its package
# directory, to avoid mixing its files with FireHPC library in debian/tmp.
NVIDIA_FAKE_ENV = PYBUILD_NAME=nvidia-fake PYBUILD_DESTDIR=debian/firehpc-nvidia-fake
NVIDIA_FAKE_ARGS = --sourcedirectory=utils/nvidia-fake

%:
	dh $@ --with python3 --with bash-completion --buildsystem=pybuild

override_dh_auto_build:
{% if version.dist == "ubuntu2204" %}
	rfl-install-setup-generator
	cd utils/nvidia-fake && rfl-install-setup-generator
{% endif %}
	dh_auto_build
	$(NVIDIA_FAKE_ENV) dh_auto_build $(NVIDIA_FAKE_ARGS)
	make -C docs man

override_dh_auto_install:
	dh_auto_install
	$(NVIDIA_FAKE_ENV) dh_auto_install $(NVIDIA_FAKE_ARGS)

override_dh_auto_clean:
	dh_auto_clean
	$(NVIDIA_FAKE_ENV) dh_auto_clean $(NVIDIA_FAKE_ARGS)

# Do not generate dependencies from Python package metadata, they are declared
# explicitly in control file. This avoids pulling all CLI dependencies with
# firehpc-agent on remote hosts.
override_dh_python3:
	dh_python3 --no-guessing-deps

# Fake DCGM exporter service is not enabled nor started at installation, as it
# requires configuration file generated by FireHPC nvidia-fake role which
# enables and starts the service by itself.
override_dh_installsystemd:
	dh_installsystemd -Nfirehpc-nvidia-fake
	dh_installsystemd -pfirehpc-nvidia-fake --no-enable --no-start

# Can be dropped in compat level 14
execute_after_dh_installinit:
	dh_installsysusers
