[Distribution]
Distribution=debian
Release=bullseye

[Output]
Format=disk
CompressOutput=xz
# Images have no ESP partition, which is required by El Torito boot catalog
# that mkosi enables by default with systemd-repart >= 261.
ElTorito=no

[Content]
WithDocs=yes
Packages=
  systemd
  dbus
  apt
  ca-certificates
  python3
  iproute2
  iputils-ping
  libnss-resolve
  openssh-client
  openssh-server
  tzdata
